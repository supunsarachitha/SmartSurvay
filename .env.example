# SmartSurvey — Docker settings. Copy this file to ".env" (same folder as docker-compose.yml) and adjust.
# docker compose reads .env automatically. Never commit your real .env file.

# --- Administrator (only used when the first admin account is created on an empty database) ---
# The first admin gets the workspace "Default workspace". With DEMO_DATA=true the same password is used for
# admin@acme.local, the admin of the second demo workspace "Acme Research".
ADMIN_EMAIL=admin@smartsurvey.local
ADMIN_PASSWORD=ChangeMe123!

# --- Super admin (runs the system: workspaces, accounts, branding, settings) ---
# Created at start-up when no super admin exists yet. Change the password right after the first sign-in.
SUPERADMIN_EMAIL=superadmin@smartsurvey.local
SUPERADMIN_PASSWORD=ChangeMe123!

# --- Database ---
POSTGRES_PASSWORD=smartsurvey
POSTGRES_PORT=5432

# --- Web app ---
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
# Example surveys, responses and a report (set to false for real use)
DEMO_DATA=true
# Interactive API documentation at /swagger
SWAGGER_ENABLED=true

# --- Encrypt respondents' written answers in the database (true/false) ---
# The keys are in the Docker volume "keys": back it up together with the database (see README → Run with Docker).
ENCRYPTION=true

# --- Spam protection for anonymous responses (true/false) ---
BOT_PROTECTION=true

# --- Links shown on the website ---
BMC_USERNAME=jkhy9gtjs
GITHUB_URL=https://github.com/supunsarachitha/SmartSurvay

# --- E-mail for password reset / account confirmation (optional; empty SMTP_HOST = off) ---
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=Auto
SMTP_USERNAME=
SMTP_PASSWORD=
