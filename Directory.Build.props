<Project>
  <!--
    Shared MSBuild settings for every project in the solution.
    To move to a newer .NET change TargetFramework here and the SDK in global.json (currently .NET 10 LTS).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Product>SmartSurvey</Product>
    <Company>SmartSurvey</Company>
    <Version>2.0.0</Version>
    <Copyright>Copyright (c) 2026 Supun (github.com/supunsarachitha). PolyForm Noncommercial License 1.0.0.</Copyright>
    <!-- XML docs feed Swagger and IntelliSense; CS1591 (missing XML comment) is silenced for
         generated code such as Razor components and EF migrations. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
