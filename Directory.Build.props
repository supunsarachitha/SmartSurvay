<Project>
  <!--
    Shared MSBuild settings for every project in the solution.
    To move to a newer .NET (e.g. .NET 10 LTS) change TargetFramework here and the SDK in global.json.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Product>SmartSurvey</Product>
    <Company>SmartSurvey</Company>
    <Version>1.0.0</Version>
    <!-- XML docs feed Swagger and IntelliSense; CS1591 (missing XML comment) is silenced for
         generated code such as Razor components and EF migrations. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
