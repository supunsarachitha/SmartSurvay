# Normalise line endings (LF in the repository and working tree) for cross-platform builds (Docker/Linux CI).
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.xlsx binary
*.webp binary

# Project website: pages generated by scripts/pages (collapsed in diffs, not counted as the project's language)
/*.html linguist-generated
/img/** linguist-generated
/assets/fonts/** linguist-generated
/assets/*.png linguist-generated
