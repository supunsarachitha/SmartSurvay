@* Light/dark theme switch. Pure JS (data-action handled in wwwroot/js/app.js) so it also works on
   statically rendered pages. The icon is updated by SmartSurvey.applyTheme(). *@
<button type="button" class="btn btn-icon btn-light theme-toggle" data-action="toggle-theme"
        title="Toggle light / dark theme" aria-label="Toggle light / dark theme">
    <i data-theme-icon class="bi bi-moon-stars"></i>
</button>
