@* Completion message shown after submitting a survey (thank-you pages and the admin preview).
   Actions (answer again, my responses, …) are passed as child content. *@

<div class="survey-shell">
    <div class="card text-center">
        <div class="card-body p-4 p-md-5">
            <div class="success-check" aria-hidden="true"><i class="bi bi-check-lg"></i></div>
            <h1 class="h3 fw-bold mb-2">Thank you!</h1>
            <p class="text-muted mb-0">
                @if (string.IsNullOrWhiteSpace(SurveyTitle))
                {
                    <span>Your response has been recorded.</span>
                }
                else
                {
                    <span>Your response to <strong class="text-body">@SurveyTitle</strong> has been recorded.</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="thank-you-message text-pre-line mt-4 mx-auto">@Message</div>
            }
            @if (ChildContent is not null)
            {
                <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">@ChildContent</div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Title of the answered survey (null = generic text).</summary>
    [Parameter] public string? SurveyTitle { get; set; }

    /// <summary>The survey's thank-you message.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Action buttons.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
