@inherits LayoutComponentBase
@layout AccountLayout
@inject CurrentWorkspace CurrentWorkspace
@* Account settings: who is signed in and the settings navigation on the left, the selected page's sections
   (SettingsCard) on the right. *@

<div class="py-3">
    <PageHeader Title="Account settings" Subtitle="Your profile, sign-in and security." />
    <div class="row g-4">
        <aside class="col-lg-4 col-xl-3">
            <div class="card">
                <div class="card-body p-3">
                    <div class="account-summary p-2">
                        <span class="avatar avatar-lg" aria-hidden="true">@UiFormat.Initials(displayName)</span>
                        <div class="min-w-0">
                            <div class="account-name text-truncate" title="@displayName">@displayName</div>
                            @if (email != displayName)
                            {
                                <div class="small text-muted text-truncate" title="@email">@email</div>
                            }
                            <span class="badge badge-soft-primary mt-1"><i class="bi @roleIcon me-1"></i>@roleLabel</span>
                        </div>
                    </div>
                    @if (workspace is not null)
                    {
                        <div class="small text-muted px-2 pb-1 text-truncate"><i class="bi bi-buildings me-1"></i>@workspace.Name</div>
                    }
                    <hr class="my-2" />
                    <ManageNavMenu />
                </div>
            </div>
        </aside>
        <div class="col-lg-8 col-xl-9">
            @Body
        </div>
    </div>
</div>

@code {
    private string? displayName;
    private string? email;
    private string roleLabel = "Member";
    private string roleIcon = "bi-person";
    private WorkspaceInfo? workspace;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            email = user.Identity?.Name;
            displayName = user.FindFirst(AppClaimsPrincipalFactory.DisplayNameClaim)?.Value ?? email;
            (roleLabel, roleIcon) = user.IsInRole(AppRoles.SuperAdmin) ? ("Super admin", "bi-shield-lock")
                : user.IsInRole(AppRoles.Admin) ? ("Admin", "bi-person-gear")
                : ("Member", "bi-person");
        }

        workspace = await CurrentWorkspace.GetAsync();
    }
}
