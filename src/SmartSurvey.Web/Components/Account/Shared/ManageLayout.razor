@inherits LayoutComponentBase
@layout AccountLayout
@* Account settings: navigation on the left, the selected settings page on the right. *@

<div class="py-3">
    <PageHeader Title="Account settings" Subtitle="Manage your profile, sign-in and security." />
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card">
                <div class="card-body p-2">
                    <ManageNavMenu />
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="card">
                <div class="card-body p-4">
                    @Body
                </div>
            </div>
        </div>
    </div>
</div>
