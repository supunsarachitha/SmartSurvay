@* Success/error message passed as a parameter or through the status cookie set by
   IdentityRedirectManager. Messages starting with "Error" are shown as errors (prefix removed). *@
@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var isError = DisplayMessage.StartsWith("Error", StringComparison.Ordinal);
    var text = isError ? DisplayMessage["Error".Length..].TrimStart(':', ' ') : DisplayMessage;
    <div class="alert alert-@(isError ? "danger" : "success") d-flex gap-2 align-items-start" role="alert">
        <i class="bi @(isError ? "bi-exclamation-triangle" : "bi-check-circle")"></i>
        <span>@text</span>
    </div>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
