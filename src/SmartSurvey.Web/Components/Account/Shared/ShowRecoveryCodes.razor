@* Freshly generated recovery codes (shown once). *@

<StatusMessage Message="@StatusMessage" />

<SettingsCard Icon="bi-key" Title="Your recovery codes" Description="Each code signs you in once when you can't use your authenticator app.">
    <div class="alert alert-warning small d-flex gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <span><strong>Put these codes in a safe place — they are shown only now.</strong> If you lose your device and don't have them, you lose access to your account.</span>
    </div>
    <div class="recovery-codes">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <code class="recovery-code">@recoveryCode</code>
        }
    </div>
</SettingsCard>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
