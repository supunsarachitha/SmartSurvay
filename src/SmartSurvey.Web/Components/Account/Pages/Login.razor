@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using SmartSurvey.Application.Workspaces
@using SmartSurvey.Domain.Entities
@using SmartSurvey.Domain.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IWorkspaceStatusProvider Workspaces
@inject TimeProvider Time
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Sign in</PageTitle>

<div class="card auth-card">
        <div class="card-body">
            <div class="text-center mb-4">
                <BrandMark ShowName="false" Size="lg" />
                <h1 class="h4 fw-bold mt-3 mb-1">Welcome back</h1>
                <p class="text-muted small mb-0">Sign in to continue to your surveys.</p>
            </div>

            <StatusMessage Message="@errorMessage" />
            <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label for="login-email" class="form-label">E-mail</label>
                    <InputText id="login-email" @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <ValidationMessage For="() => Input.Email" class="validation-message" />
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <label for="login-password" class="form-label">Password</label>
                        <a class="small" href="Account/ForgotPassword">Forgot password?</a>
                    </div>
                    <InputText id="login-password" type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                    <ValidationMessage For="() => Input.Password" class="validation-message" />
                </div>
                <div class="form-check mb-4">
                    <InputCheckbox id="login-remember" @bind-Value="Input.RememberMe" class="form-check-input" />
                    <label class="form-check-label" for="login-remember">Keep me signed in</label>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary"><i class="bi bi-box-arrow-in-right"></i>Sign in</button>
            </EditForm>

            @if (hasExternalLogins)
            {
                <div class="divider-text my-4">or</div>
                <ExternalLoginPicker />
            }

            <div class="divider-text my-4">New here?</div>
            <a class="btn btn-light w-100" href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">
                <i class="bi bi-person-plus"></i>Create a free account
            </a>
            <p class="text-center small mt-3 mb-0">
                <a class="text-muted" href="Account/ResendEmailConfirmation">Didn't get the confirmation e-mail?</a>
            </p>
        </div>
</div>

@code {
    private string? errorMessage;
    private bool hasExternalLogins;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }

        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }

    public async Task LoginUser()
    {
        // Failed attempts count towards the lockout configured in Program.cs (5 attempts → 15 minutes).
        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            await RecordLoginAsync();
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else if (result.IsNotAllowed && await BlockedWorkspaceReasonAsync() is { } reason)
        {
            RedirectManager.RedirectTo("workspace-unavailable", new() { ["reason"] = reason });
        }
        else
        {
            errorMessage = "Error: The e-mail address or password is not correct.";
        }
    }

    /// <summary>
    /// "pending" / "disabled" when sign-in was refused because of the account's workspace. Identity refuses
    /// before it checks the password, so the password is verified first: strangers learn nothing.
    /// </summary>
    private async Task<string?> BlockedWorkspaceReasonAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email) ?? await UserManager.FindByNameAsync(Input.Email);
        if (user?.WorkspaceId is not { } workspaceId || !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            return null;
        }

        return await Workspaces.GetStatusAsync(workspaceId) switch
        {
            WorkspaceStatus.PendingApproval => "pending",
            WorkspaceStatus.Active => null,
            _ => "disabled",
        };
    }

    /// <summary>Stores the sign-in time shown on the admin Users page (best effort).</summary>
    private async Task RecordLoginAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email) ?? await UserManager.FindByNameAsync(Input.Email);
        if (user is null)
        {
            return;
        }

        user.LastLoginAt = Time.GetUtcNow().UtcDateTime;
        var update = await UserManager.UpdateAsync(user);
        if (!update.Succeeded)
        {
            Logger.LogWarning("Could not record the sign-in time of user {UserId}", user.Id);
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Please enter your e-mail address.")]
        [EmailAddress(ErrorMessage = "Please enter a valid e-mail address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Please enter your password.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Keep me signed in")]
        public bool RememberMe { get; set; }
    }
}
