@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Personal data</PageTitle>

<StatusMessage />

<SettingsCard Icon="bi-download" Title="Download your data" Description="A JSON file with the personal data stored in your account.">
    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <button class="btn btn-light" type="submit"><i class="bi bi-download"></i>Download</button>
    </form>
</SettingsCard>

<SettingsCard Icon="bi-trash" Title="Delete account" Description="Permanently removes your account and its personal data. This cannot be undone." Danger="true">
    <a href="Account/Manage/DeletePersonalData" class="btn btn-soft-danger"><i class="bi bi-trash"></i>Delete my account…</a>
</SettingsCard>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
