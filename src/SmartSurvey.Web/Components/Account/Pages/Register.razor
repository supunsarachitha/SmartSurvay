@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SmartSurvey.Application.Common
@using SmartSurvey.Application.Workspaces
@using SmartSurvey.Domain.Identity

@inject IWorkspaceService Workspaces
@inject IWorkspaceSignupService Signup
@inject AccountEmails AccountEmails
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

@* Accounts belong to a workspace. With ?workspace={slug} this is that workspace's join form (when it
   accepts members through its link); without it the page explains the two ways in. *@

<PageTitle>@(workspace is null ? "Create account" : $"Join {workspace.Name}")</PageTitle>

<div class="card auth-card">
    <div class="card-body">
        @if (string.IsNullOrWhiteSpace(WorkspaceSlug))
        {
            <div class="text-center mb-4">
                <BrandMark ShowName="false" Size="lg" />
                <h1 class="h4 fw-bold mt-3 mb-1">How would you like to start?</h1>
                <p class="text-muted small mb-0">Every account belongs to a workspace — a private space for surveys.</p>
            </div>
            <a class="card card-hover text-decoration-none mb-3" href="signup">
                <div class="card-body d-flex gap-3 align-items-start">
                    <span class="feature-icon"><i class="bi bi-building-add"></i></span>
                    <span>
                        <span class="fw-semibold d-block text-body">Create a workspace</span>
                        <span class="small text-muted">Build surveys and reports for your team or audience. You become its admin.</span>
                    </span>
                </div>
            </a>
            <div class="card">
                <div class="card-body">
                    <div class="d-flex gap-3 align-items-start mb-3">
                        <span class="feature-icon"><i class="bi bi-people"></i></span>
                        <span>
                            <span class="fw-semibold d-block">Join a workspace</span>
                            <span class="small text-muted">Open the join link its admin gave you, or enter the workspace address.</span>
                        </span>
                    </div>
                    <form method="get" action="Account/Register" class="input-group">
                        <span class="input-group-text text-muted small">/w/</span>
                        <input class="form-control" name="workspace" placeholder="workspace-address" aria-label="Workspace address" required />
                        <button class="btn btn-soft-primary" type="submit">Continue</button>
                    </form>
                </div>
            </div>
        }
        else if (workspace is null)
        {
            <EmptyState Icon="bi-question-circle" Title="Workspace not found"
                        Message="There is no active workspace at this address. Please check the link you received.">
                <a class="btn btn-light" href="Account/Register"><i class="bi bi-arrow-left"></i>Back</a>
            </EmptyState>
        }
        else if (!workspace.AllowSelfRegistration)
        {
            <EmptyState Icon="bi-door-closed" Title="@($"{workspace.Name} is invite-only")"
                        Message="This workspace does not accept new members through its link. Please ask its administrator for an account.">
                @if (!string.IsNullOrWhiteSpace(workspace.ContactEmail))
                {
                    <a class="btn btn-primary" href="mailto:@workspace.ContactEmail"><i class="bi bi-envelope"></i>Contact the workspace</a>
                }
            </EmptyState>
        }
        else
        {
            <div class="text-center mb-4">
                <BrandMark ShowName="false" Size="lg" />
                <h1 class="h4 fw-bold mt-3 mb-1">Join @workspace.Name</h1>
                <p class="text-muted small mb-0">Create your account to answer this workspace's surveys and save your progress.</p>
            </div>

            <StatusMessage Message="@errorMessage" />
            <EditForm Model="Input" method="post" OnValidSubmit="JoinWorkspace" FormName="register">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label for="register-name" class="form-label">Name <span class="text-muted small">(optional)</span></label>
                    <InputText id="register-name" @bind-Value="Input.DisplayName" class="form-control" autocomplete="name" placeholder="How should we call you?" />
                    <ValidationMessage For="() => Input.DisplayName" class="validation-message" />
                </div>
                <div class="mb-3">
                    <label for="register-email" class="form-label">E-mail</label>
                    <InputText id="register-email" @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <ValidationMessage For="() => Input.Email" class="validation-message" />
                </div>
                <div class="mb-3">
                    <label for="register-password" class="form-label">Password</label>
                    <InputText id="register-password" type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="register-password-help" />
                    <div id="register-password-help" class="form-text">At least 8 characters with upper- and lower-case letters, a digit and a symbol.</div>
                    <ValidationMessage For="() => Input.Password" class="validation-message" />
                </div>
                <div class="mb-4">
                    <label for="register-confirm" class="form-label">Confirm password</label>
                    <InputText id="register-confirm" type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                    <ValidationMessage For="() => Input.ConfirmPassword" class="validation-message" />
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary"><i class="bi bi-person-plus"></i>Join workspace</button>
            </EditForm>
        }

        <div class="divider-text my-4">Already have an account?</div>
        <a class="btn btn-light w-100" href="@(NavigationManager.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">
            <i class="bi bi-box-arrow-in-right"></i>Sign in
        </a>
    </div>
</div>

@code {
    private PublicWorkspaceDto? workspace;
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    /// <summary>Address of the workspace to join.</summary>
    [SupplyParameterFromQuery(Name = "workspace")]
    private string? WorkspaceSlug { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(WorkspaceSlug))
        {
            workspace = await Workspaces.FindPublicAsync(WorkspaceSlug);
        }
    }

    public async Task JoinWorkspace()
    {
        JoinWorkspaceResult result;
        try
        {
            result = await Signup.JoinAsync(WorkspaceSlug!, new JoinWorkspaceRequest
            {
                DisplayName = Input.DisplayName,
                Email = Input.Email,
                Password = Input.Password,
            });
        }
        catch (AppException ex) when (UiErrors.IsExpected(ex))
        {
            errorMessage = "Error: " + UiErrors.Describe(ex);
            return;
        }

        Logger.LogInformation("A member joined workspace {Slug}.", WorkspaceSlug);
        var destination = string.IsNullOrEmpty(ReturnUrl) ? $"w/{workspace!.Slug}" : ReturnUrl;
        await AccountEmails.SendConfirmationAsync(result.UserId, NavigationManager.BaseUri, ReturnUrl);

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            RedirectManager.RedirectTo("Account/RegisterConfirmation", new() { ["email"] = Input.Email, ["returnUrl"] = ReturnUrl });
        }

        var user = await UserManager.FindByIdAsync(result.UserId.ToString());
        await SignInManager.SignInAsync(user!, isPersistent: false);
        RedirectManager.RedirectTo(destination);
    }

    private sealed class InputModel
    {
        [StringLength(200, ErrorMessage = "Use at most {1} characters.")]
        public string? DisplayName { get; set; }

        [Required(ErrorMessage = "Please enter your e-mail address.")]
        [EmailAddress(ErrorMessage = "Please enter a valid e-mail address.")]
        [Display(Name = "E-mail")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Please choose a password.")]
        [StringLength(100, ErrorMessage = "The password must be at least {2} characters long.", MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
