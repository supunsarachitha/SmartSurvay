@page "/surveys"
@inject IResponseService Responses
@inject ICurrentUser CurrentUser
@inject CurrentWorkspace CurrentWorkspace
@inject NavigationManager NavigationManager
@* Surveys the member can take now in their own workspace (static SSR), with their progress (draft /
   completed). Surveys belong to workspaces, so guests are pointed to survey links and workspace pages;
   super admins run the system and do not answer surveys. *@

<div class="container py-5">
    <PageHeader Title="Open surveys"
                Subtitle="@(workspace is null ? "Pick a survey and share your thoughts — most take just a few minutes." : $"Surveys of {workspace.Name} — most take just a few minutes.")" />

    @if (CurrentUser.IsSuperAdmin)
    {
        <EmptyState Icon="bi-shield-lock" Title="Super admins do not answer surveys"
                    Message="Surveys belong to workspaces. Manage workspaces, accounts and settings in the System console.">
            <a class="btn btn-primary" href="system"><i class="bi bi-shield-lock"></i>Open System console</a>
        </EmptyState>
    }
    else if (!CurrentUser.IsAuthenticated)
    {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-semibold"><i class="bi bi-link-45deg text-primary me-1"></i>Got a survey link?</h2>
                        <p class="text-muted mb-3">Surveys are shared by the workspace that runs them. Open the link you received, or go to the workspace's page:</p>
                        <form method="get" action="surveys" class="input-group" style="max-width:26rem">
                            <span class="input-group-text text-muted small">/w/</span>
                            <input class="form-control" name="workspace" placeholder="workspace-address" aria-label="Workspace address" required />
                            <button class="btn btn-primary" type="submit">Open</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-semibold"><i class="bi bi-person-check text-primary me-1"></i>Member of a workspace?</h2>
                        <p class="text-muted mb-3">Sign in to see your workspace's surveys and continue where you left off.</p>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-soft-primary" href="Account/Login?ReturnUrl=%2Fsurveys"><i class="bi bi-box-arrow-in-right"></i>Sign in</a>
                            <a class="btn btn-light" href="signup"><i class="bi bi-building-add"></i>Create a workspace</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
    @if (surveys.Count > 0)
    {
        <form method="get" action="surveys" class="mb-4" role="search" style="max-width:28rem">
            <div class="input-group">
                <span class="input-group-text bg-body"><i class="bi bi-search"></i></span>
                <input class="form-control" type="search" name="q" value="@Q" placeholder="Search surveys" aria-label="Search surveys" />
            </div>
        </form>
    }

    @if (surveys.Count == 0)
    {
        <EmptyState Icon="bi-clipboard-check" Title="No open surveys right now"
                    Message="Check back soon — new surveys appear here as soon as they are published." />
    }
    else if (visible.Count == 0)
    {
        <EmptyState Icon="bi-search" Title="No surveys match your search" Message="Try another word.">
            <a class="btn btn-soft-primary" href="surveys">Show all surveys</a>
        </EmptyState>
    }
    else
    {
        <div class="row g-4">
            @foreach (var survey in visible)
            {
                <div class="col-md-6 col-xl-4">
                    <SurveyCard Survey="survey" />
                </div>
            }
        </div>
    }
    }
</div>

@code {
    private IReadOnlyList<AvailableSurveyDto> surveys = [];
    private List<AvailableSurveyDto> visible = [];
    private WorkspaceInfo? workspace;

    /// <summary>Search term.</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    /// <summary>Workspace address entered by a guest: opens that workspace's page.</summary>
    [SupplyParameterFromQuery(Name = "workspace")] public string? Workspace { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Workspace))
        {
            NavigationManager.NavigateTo($"w/{Uri.EscapeDataString(Workspace.Trim().ToLowerInvariant())}");
            return;
        }

        workspace = await CurrentWorkspace.GetAsync();
        surveys = await Responses.ListAvailableAsync();
        var term = Q?.Trim();
        visible = string.IsNullOrEmpty(term)
            ? surveys.ToList()
            : surveys.Where(s => s.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                                 || (s.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
    }
}
