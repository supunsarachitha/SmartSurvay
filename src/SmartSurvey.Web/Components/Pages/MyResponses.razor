@page "/my/responses"
@attribute [Authorize]
@inject IResponseService Responses
@* The signed-in user's submissions and drafts (static SSR). *@

<div class="container py-5">
    <PageHeader Title="My responses" Subtitle="Surveys you have answered or started.">
        <Actions>
            <a class="btn btn-primary" href="surveys"><i class="bi bi-ui-checks"></i>Find surveys</a>
        </Actions>
    </PageHeader>

    @if (responses.Count == 0)
    {
        <EmptyState Icon="bi-journal-check" Title="No responses yet" Message="When you answer or start a survey, it shows up here so you can pick up where you left off.">
            <a class="btn btn-primary" href="surveys"><i class="bi bi-arrow-right-circle"></i>Browse open surveys</a>
        </EmptyState>
    }
    else
    {
        @if (drafts > 0)
        {
            <div class="alert alert-light border mb-4">
                <i class="bi bi-pencil-square text-primary me-2"></i>
                You have @drafts unfinished survey@(drafts == 1 ? "" : "s"). Your answers are saved — continue whenever you like.
            </div>
        }

        <div class="card table-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Survey</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="d-none d-md-table-cell">Started</th>
                            <th scope="col">Submitted</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var response in responses)
                        {
                            <tr>
                                <td class="fw-semibold">@response.SurveyTitle</td>
                                <td><StatusBadge ResponseStatus="response.Status" /></td>
                                <td class="d-none d-md-table-cell text-muted"><LocalDateTime Value="response.StartedAt" /></td>
                                <td class="text-muted"><LocalDateTime Value="response.SubmittedAt" /></td>
                                <td class="text-end">
                                    @if (response.CanContinue)
                                    {
                                        <a class="btn btn-sm btn-soft-primary" href="s/@response.Slug"><i class="bi bi-play-circle"></i>Continue</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<MyResponseDto> responses = [];
    private int drafts;

    protected override async Task OnInitializedAsync()
    {
        responses = await Responses.ListMineAsync();
        drafts = responses.Count(r => r.CanContinue);
    }
}
