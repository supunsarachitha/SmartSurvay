@page "/faq"
@using SmartSurvey.Application.Branding
@inject IBrandingService BrandingService
@inject IOptions<SupportOptions> Support
@* Frequently asked questions (static SSR). The search box is a plain GET form (?q=), so it works
   without interactivity; accordions use Bootstrap's JavaScript. *@

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <PageHeader Title="Frequently asked questions" Subtitle="@($"Everything you need to know about {productName}.")" />
            <p class="small text-muted mb-4"><i class="bi bi-book me-1"></i>Looking for step-by-step instructions? Read the <a href="guide">user guide</a>.</p>

            <form method="get" action="faq" class="mb-4" role="search">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-body"><i class="bi bi-search"></i></span>
                    <input class="form-control" type="search" name="q" value="@Q" placeholder="Search the FAQ, e.g. “export” or “logic”"
                           aria-label="Search the FAQ" />
                    <button class="btn btn-primary" type="submit">Search</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(Q))
                {
                    <div class="small text-muted mt-2">
                        @matchCount result@(matchCount == 1 ? "" : "s") for “@Q” · <a href="faq">Clear search</a>
                    </div>
                }
            </form>

            @if (matchCount == 0)
            {
                <EmptyState Icon="bi-search" Title="No matching questions" Message="Try a different word, or browse all questions.">
                    <a class="btn btn-soft-primary" href="faq">Show all questions</a>
                </EmptyState>
            }

            @foreach (var group in visibleGroups)
            {
                <h2 class="h5 fw-semibold mt-4 mb-3"><i class="bi @group.Icon text-primary me-2"></i>@group.Title</h2>
                <div class="accordion mb-3" id="faq-@group.Id">
                    @for (var i = 0; i < group.Items.Count; i++)
                    {
                        var item = group.Items[i];
                        var id = $"faq-{group.Id}-{i}";
                        var expanded = !string.IsNullOrWhiteSpace(Q);
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button @(expanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#@id" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@id">
                                    @item.Question
                                </button>
                            </h3>
                            <div id="@id" class="accordion-collapse collapse @(expanded ? "show" : "")" data-bs-parent="#faq-@group.Id">
                                <div class="accordion-body text-muted">@item.Answer</div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="surface p-4 mt-5 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h2 class="h6 fw-semibold mb-1">Still have a question?</h2>
                    <p class="text-muted small mb-0">
                        @if (!string.IsNullOrWhiteSpace(Support.Value.ContactEmail))
                        {
                            <text>Write to us at <a href="mailto:@Support.Value.ContactEmail">@Support.Value.ContactEmail</a> — we're happy to help.</text>
                        }
                        else
                        {
                            <text>Contact the administrator of this site — they're happy to help.</text>
                        }
                    </p>
                </div>
                <a class="btn btn-coffee" href="buy-me-a-coffee"><i class="bi bi-cup-hot"></i>Support the project</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string productName = BrandingDefaults.ProductName;
    private List<FaqGroup> visibleGroups = [];
    private int matchCount;

    /// <summary>Search term.</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private sealed record FaqItem(string Question, string Answer);

    private sealed record FaqGroup(string Id, string Title, string Icon, List<FaqItem> Items);

    protected override async Task OnInitializedAsync()
    {
        productName = (await BrandingService.GetAsync()).ProductName;
        var groups = BuildGroups();
        var term = Q?.Trim();

        visibleGroups = string.IsNullOrEmpty(term)
            ? groups
            : groups
                .Select(g => g with
                {
                    Items = g.Items
                        .Where(i => i.Question.Contains(term, StringComparison.OrdinalIgnoreCase) || i.Answer.Contains(term, StringComparison.OrdinalIgnoreCase))
                        .ToList(),
                })
                .Where(g => g.Items.Count > 0)
                .ToList();
        matchCount = visibleGroups.Sum(g => g.Items.Count);
    }

    private List<FaqGroup> BuildGroups() =>
    [
        new("general", "General", "bi-info-circle",
        [
            new($"What is {productName}?",
                $"{productName} is a web application for creating surveys, collecting responses and analysing them with reports and charts. Administrators design surveys and reports; respondents answer surveys in their browser on any device."),
            new("Do I need an account to answer a survey?",
                "Not always. Each survey decides whether anonymous answers are allowed. Surveys that require an account are for members of the workspace that runs them: create your account with the workspace's join link — it's free and takes a few seconds."),
            new("Does it work on phones and tablets?",
                "Yes. Every page is responsive, and surveys are designed to be comfortable to answer on small screens."),
            new("Is there a dark mode?",
                "Yes — use the moon/sun button in the top bar. Your choice is remembered on this device."),
        ]),
        new("workspaces", "Workspaces", "bi-buildings",
        [
            new("What is a workspace?",
                "The private space of a team, class, club or company. Each workspace has its own administrators, members, surveys, answers and reports. Workspaces are completely separate: nobody outside a workspace can see its surveys, answers or members."),
            new("How do I create a workspace?",
                "Choose “Create workspace”, enter a name and create your account — you become its administrator and can build your first survey right away. On some sites a site administrator approves new workspaces first; you can sign in as soon as yours is approved."),
            new("How do people join my workspace?",
                "Switch on the join link in Workspace settings and share it (Users page → Copy link). People who open it create a member account in your workspace. You can also add members yourself on the Users page, and switch the join link off at any time."),
            new("Can I belong to two workspaces?",
                "One account belongs to exactly one workspace. To take part in a second workspace, create another account there with a different e-mail address."),
            new("What happens when a workspace is disabled?",
                "A site administrator can switch a workspace off. Its members are signed out and cannot sign in, and its survey links show that the survey is not available. Nothing is deleted — when the workspace is switched on again, everything is back."),
            new("Who can see my workspace's answers?",
                "Only the administrators of your workspace. Site administrators (super admins) manage workspaces and accounts, but cannot open any workspace's surveys, answers or reports."),
        ]),
        new("surveys", "Building surveys", "bi-ui-checks",
        [
            new("Which question types are available?",
                "Ten: short text, long text, single choice (radio buttons), multiple choice (checkboxes), dropdown, number, e-mail, date, star rating and scale (for example 0–10). Choice questions can include an “Other” option with a free-text box."),
            new("What is conditional logic?",
                "Rules that show or hide a question depending on earlier answers — for example, ask “What should we improve?” only when someone answers “No” to “Are you satisfied?”. A rule can require all or any of its conditions. Hidden questions are skipped and never required, and the server applies the same rules when a response is submitted."),
            new("Can a survey have several pages?",
                "Yes. Split a survey into pages (sections); respondents see a progress bar and can move back and forth. Signed-in respondents can save a draft and continue later."),
            new("Can I reuse a survey?",
                "Yes. Duplicate any survey, save it as a template to start new surveys from, or export its design as a JSON file and import it into another installation."),
            new("Can I limit when and how often people respond?",
                "Yes. Set an opening and closing date, a maximum number of responses, whether anonymous responses are allowed and whether one person may respond more than once."),
            new("How do I share a survey?",
                "Publish it, then copy its link or download the QR code from the share page. Published surveys that allow it also appear on the public Surveys page."),
            new("Are surveys protected against spam and bots?",
                "Yes, automatically. Anonymous responses must pass invisible checks: the browser solves a small puzzle in the background while you answer (a so-called proof of work — easy for one person, expensive for spam robots), responses sent within seconds of opening a survey are rejected, a hidden field catches form-filling robots, and every check can only be used once. There is no CAPTCHA to click and no third-party service involved. Submissions are also rate-limited."),
            new("Can I protect a survey with a password?",
                "Yes. In the survey's Settings, switch on “Require a password to open the survey” and choose a password. Respondents must enter it before they can see the questions; share it together with (or separately from) the link. The password is stored as a secure hash, can be changed or removed any time, and protected surveys are not listed on the public Surveys page."),
        ]),
        new("responses", "Responses and privacy", "bi-shield-check",
        [
            new("Who can see my answers?",
                "Only the administrators of this site. Other respondents never see your answers. Reports show aggregated results and the free-text answers you gave."),
            new("Is my data encrypted?",
                "Yes. The answers you type — text answers, e-mail addresses you enter in a survey and “Other” texts — and your browser details are stored encrypted in the database (AES-256). The keys are kept separately from the database, so a copy of the database alone doesn't reveal them. Choices, numbers and dates are stored as they are so the charts can be calculated. Passwords are never stored — only secure hashes. Connections to this site should use HTTPS."),
            new("Are anonymous responses really anonymous?",
                "When you are not signed in, your response is not linked to an account. The browser type is stored to help spot abuse; no name or e-mail is recorded unless a question asks for it."),
            new("A survey asks me for a password — where do I get it?",
                "From the person or organisation who sent you the link. The survey owner chose it; this website cannot tell you the password."),
            new("Can I change my answers after submitting?",
                "Submitted responses are final. Until you submit, signed-in respondents can save a draft and come back to it from “My responses”."),
            new("What happens to my responses if my account is deleted?",
                "They are kept for the survey's statistics but no longer linked to any account, so they become anonymous."),
        ]),
        new("reports", "Reports and exports", "bi-bar-chart-line",
        [
            new("What can a report contain?",
                "Summary KPIs (responses, completion rate, average time), bar, horizontal bar, pie, doughnut and line charts, distribution tables with percentages, rating and number statistics, cross-tabulations of two questions, lists of text answers and a raw response grid."),
            new("Can I filter a report?",
                "Yes — by date range, by response status (include unfinished drafts or not) and by answers, for example “only respondents from Europe who rated us 4 or higher”."),
            new("Which export formats are supported?",
                "Reports: PDF (with charts), Excel, CSV, plain text and JSON. Raw responses: CSV, Excel and JSON with one row per response and one column per question."),
            new("Is there a quick way to get a report?",
                "Yes. Generate the automatic overview report for any survey — one widget per question — and then adjust it in the report builder with a live preview."),
        ]),
        new("admin", "Administration", "bi-gear",
        [
            new("How do I become an administrator?",
                "Whoever creates a workspace is its first administrator. An administrator of your workspace can give your account the Admin role on the Users page."),
            new("Who are super admins?",
                "The people who run the whole site. In the System console they create, approve, disable and delete workspaces, manage accounts, the branding and the site settings — without access to the workspaces' surveys and answers."),
            new("Can I change the product name and logo?",
                "The product name, tagline and logo apply to the whole site, so super admins set them (System → Branding). Workspace administrators can change their workspace's name, description and contact e-mail in Workspace settings."),
            new("Is there an audit trail?",
                "Yes. Important actions — creating, publishing and deleting surveys, exports, member and settings changes — are recorded in the workspace's audit log with who did what and when. Actions of super admins are recorded in a separate system audit log."),
            new("Is there an API?",
                "Yes. Everything is available over a REST API under /api/v1 with bearer-token authentication. Interactive documentation is available at /swagger when enabled by the administrator."),
        ]),
    ];
}
