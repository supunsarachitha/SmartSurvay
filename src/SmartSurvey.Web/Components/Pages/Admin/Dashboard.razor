@page "/admin"
@rendermode InteractiveServer
@inject IDashboardService DashboardService
@* Admin dashboard: KPIs, completed responses over the last 30 days, top surveys and the latest
   responses, with shortcuts to the most common tasks. *@

<PageHeader Title="Dashboard" Subtitle="Your surveys at a glance.">
    <Actions>
        <button class="btn btn-light" @onclick="LoadAsync" disabled="@loading" title="Reload the numbers">
            @if (loading)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-arrow-clockwise"></i>
            }
            Refresh
        </button>
        <a class="btn btn-light" href="admin/reports"><i class="bi bi-bar-chart-line"></i>Reports</a>
        <a class="btn btn-primary" href="admin/surveys/new"><i class="bi bi-plus-lg"></i>New survey</a>
    </Actions>
</PageHeader>

<ErrorAlert Message="@error" OnDismiss="() => error = null" Class="mb-3" />

@if (summary is null)
{
    @if (error is null)
    {
        <LoadingSpinner Text="Loading dashboard…" />
    }
}
else if (summary.TotalSurveys == 0)
{
    <EmptyState Icon="bi-rocket-takeoff" Title="Welcome! Let's create your first survey"
                Message="Build a survey with pages, conditional logic and many question types, publish it and watch the responses come in here.">
        <a class="btn btn-primary" href="admin/surveys/new"><i class="bi bi-plus-lg"></i>New survey</a>
        <a class="btn btn-soft-primary" href="admin/surveys"><i class="bi bi-files"></i>Start from a template</a>
    </EmptyState>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <StatCard Icon="bi-ui-checks-grid" Label="Surveys" Value="@UiFormat.Number(summary.TotalSurveys)"
                      Hint="@($"{summary.PublishedSurveys} live · {summary.DraftSurveys} draft · {summary.ClosedSurveys} closed")" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Icon="bi-inboxes" Variant="success" Label="Completed responses" Value="@UiFormat.Number(summary.CompletedResponses)"
                      Hint="@($"{UiFormat.Number(summary.ResponsesLast7Days)} in the last 7 days")" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Icon="bi-check2-circle" Variant="info" Label="Completion rate" Value="@UiFormat.Percent(summary.CompletionRate)"
                      Hint="@($"{UiFormat.Number(summary.InProgressResponses)} unfinished · avg. {UiFormat.Duration(summary.AverageDurationSeconds)}")" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Icon="bi-people" Variant="warning" Label="Users" Value="@UiFormat.Number(summary.TotalUsers)"
                      Hint="@UiFormat.Plural(summary.TotalReports, "saved report")" />
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="h6 mb-0">Completed responses · last 30 days</h2>
                        <span class="small text-muted">@UiFormat.Plural(summary.ResponsesPerDay.Sum(d => d.Count), "response")</span>
                    </div>
                    @if (summary.ResponsesPerDay.All(d => d.Count == 0))
                    {
                        <div class="text-center text-muted small py-5"><i class="bi bi-graph-up me-1"></i>No responses in the last 30 days yet.</div>
                    }
                    else
                    {
                        <ChartView Data="trend" Height="260" AriaLabel="Completed responses per day over the last 30 days" />
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 mb-3">Top surveys</h2>
                    @if (summary.TopSurveys.Count == 0)
                    {
                        <p class="small text-muted mb-0">No responses yet.</p>
                    }
                    else
                    {
                        var max = Math.Max(1, summary.TopSurveys.Max(s => s.CompletedResponses));
                        <ul class="list-unstyled mb-0">
                            @foreach (var survey in summary.TopSurveys)
                            {
                                <li class="mb-3">
                                    <div class="d-flex justify-content-between gap-2 small mb-1">
                                        <a class="text-body text-truncate fw-semibold text-decoration-none" href="admin/surveys/@survey.Id/responses">@survey.Title</a>
                                        <span class="text-muted text-nowrap">@UiFormat.Number(survey.CompletedResponses)</span>
                                    </div>
                                    <div class="bar-inline"><span style="width:@((100.0 * survey.CompletedResponses / max).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card table-card">
                <div class="card-body pb-0">
                    <h2 class="h6 mb-3">Latest responses</h2>
                </div>
                @if (summary.RecentResponses.Count == 0)
                {
                    <div class="card-body pt-0"><p class="small text-muted mb-0">Responses appear here as soon as they are submitted.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Survey</th>
                                    <th scope="col">Respondent</th>
                                    <th scope="col">Submitted</th>
                                    <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var response in summary.RecentResponses)
                                {
                                    <tr @key="response.ResponseId">
                                        <td class="min-w-0"><a class="text-body text-decoration-none" href="admin/surveys/@response.SurveyId/responses">@response.SurveyTitle</a></td>
                                        <td class="small">@response.RespondentName</td>
                                        <td class="small text-muted"><LocalDateTime Value="response.SubmittedAt" Relative="true" /></td>
                                        <td class="text-end"><a class="btn btn-sm btn-soft-primary" href="admin/responses/@response.ResponseId"><i class="bi bi-eye"></i>View</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private DashboardSummaryDto? summary;
    private ChartData? trend;
    private string? error;
    private bool loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            summary = await DashboardService.GetSummaryAsync();
            trend = new ChartData
            {
                Kind = ChartKind.Bar,
                Labels = summary.ResponsesPerDay.Select(d => d.Date.ToString("d MMM", System.Globalization.CultureInfo.InvariantCulture)).ToList(),
                Series = [new ChartSeries { Name = "Completed responses", Values = summary.ResponsesPerDay.Select(d => (double)d.Count).ToList() }],
            };
            error = null;
        }
        catch (Exception ex) when (UiErrors.IsExpected(ex))
        {
            error = UiErrors.Describe(ex);
        }
        finally
        {
            loading = false;
        }
    }
}
