@page "/admin/users"
@rendermode InteractiveServer
@inject IWorkspaceService Workspaces
@* The members of the admin's workspace (see AccountManager), with the join link when self-registration is on. *@

<AccountManager>
    @if (workspace is { AllowSelfRegistration: true })
    {
        <div class="card mb-3">
            <div class="card-body py-3 d-flex flex-column flex-lg-row gap-2 align-items-lg-center">
                <span class="small fw-semibold text-nowrap"><i class="bi bi-person-plus me-1"></i>Join link</span>
                <div class="flex-grow-1"><JoinLinkBox Slug="@workspace.Slug" /></div>
                <a class="small text-nowrap" href="admin/settings">Change in settings</a>
            </div>
        </div>
    }
</AccountManager>

@code {
    private WorkspaceDto? workspace;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            workspace = await Workspaces.GetCurrentAsync();
        }
        catch (Exception ex) when (UiErrors.IsExpected(ex))
        {
            workspace = null; // the list still works; only the join link is missing
        }
    }
}
