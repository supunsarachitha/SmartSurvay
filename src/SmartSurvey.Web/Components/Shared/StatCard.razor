@* KPI card. Variant: "" (primary), "success", "warning", "info", "danger". *@
<div class="card stat-card h-100 @Class">
    <div class="card-body d-flex align-items-start gap-3">
        <div class="stat-icon @Variant"><i class="bi @Icon"></i></div>
        <div class="min-w-0">
            <div class="stat-label">@Label</div>
            <div class="stat-value">@Value</div>
            @if (!string.IsNullOrWhiteSpace(Hint))
            {
                <div class="small text-muted mt-1">@Hint</div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Bootstrap icon class.</summary>
    [Parameter] public string Icon { get; set; } = "bi-graph-up";

    /// <summary>Label.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Formatted value.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    /// <summary>Small hint below the value.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Colour variant.</summary>
    [Parameter] public string Variant { get; set; } = string.Empty;

    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
}
